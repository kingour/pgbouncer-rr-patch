diff --git a/test/test_misc.py b/test/test_misc.py
index a595258..8be44d6 100644
--- a/test/test_misc.py
+++ b/test/test_misc.py
@@ -618,6 +618,55 @@ def _read_message(stream):
     return message_type, stream.read(message_length - 4)
 
 
+@pytest.mark.parametrize(
+    "header,real_ip",
+    [
+        (b"PROXY TCP4 192.0.2.10 127.0.0.1 12345 6432\r\n", "192.0.2.10"),
+        (b"PROXY TCP6 2001:db8::10 ::1 12345 6432\r\n", "2001:db8::10"),
+        (b"PROXY UNKNOWN\r\n", None),
+    ],
+)
+@pytest.mark.parametrize("fragmented", [False, True])
+def test_proxy_protocol(bouncer, header, real_ip, fragmented):
+    bouncer.admin("set proxy_protocol = 1")
+    startup = _startup_packet(b"puser1", b"p0")
+    with socket.create_connection((bouncer.host, bouncer.port), timeout=3) as sock:
+        if fragmented:
+            # Force the parser to wait for both the signature and CRLF.
+            for part in (header[:3], header[3:-1]):
+                sock.sendall(part)
+                with pytest.raises(socket.timeout):
+                    sock.recv(1)
+            sock.sendall(header[-1:] + startup)
+        else:
+            sock.sendall(header + startup)
+        with sock.makefile("rb") as stream:
+            while True:
+                message_type, message = _read_message(stream)
+                assert message_type != b"E", message
+                if message_type == b"Z":
+                    break
+            query = b"select 1\0"
+            sock.sendall(b"Q" + struct.pack("!I", len(query) + 4) + query)
+            rows = []
+            while True:
+                message_type, message = _read_message(stream)
+                assert message_type != b"E", message
+                if message_type == b"D":
+                    rows.append(message)
+                if message_type == b"Z":
+                    break
+            assert rows == [struct.pack("!HI", 1, 1) + b"1"]
+        if real_ip:
+            assert f"@{real_ip}:127.0.0.1:" in bouncer.log_path.read_text()
+
+
+@pytest.mark.parametrize("sslmode", ["disable", "prefer"])
+def test_proxy_protocol_direct_connection(bouncer, sslmode):
+    bouncer.admin("set proxy_protocol = 1")
+    assert bouncer.sql_value("select 1", sslmode=sslmode, connect_timeout=3) == 1
+
